#!/usr/bin/env python3
"""Fake hc (herdr-core) for tests. Logs argv to $FAKE_HC_LOG (one JSON list per line) and
keeps a world in $FAKE_HC_STATE: machines, home, files, terminals, screens, and the reply
`wait` gives. $FAKE_HC_FAIL makes any call whose argv starts with that prefix fail.
World flags: trust (new terminals show the trust prompt until keys are pressed),
never_ready (new terminals never report a status)."""

import json
import os
import sys

argv = sys.argv[1:]
with open(os.environ["FAKE_HC_LOG"], "a") as f:
    f.write(json.dumps(argv) + "\n")

path = os.environ["FAKE_HC_STATE"]
world = json.load(open(path)) if os.path.exists(path) else {}
world.setdefault("n", 0)
world.setdefault("machines", [{"name": "box", "state": "connected"}])
world.setdefault("home", "/home/ubuntu")
world.setdefault("files", {})
world.setdefault("terminals", {})
world.setdefault("screens", {})


def save():
    json.dump(world, open(path, "w"))


def out(result):
    save()
    print(json.dumps(result))
    sys.exit(0)


def fail(msg, kind="fake_error", code=1):
    save()
    print(json.dumps({"error": {"kind": kind, "message": msg, "hint": ""}}), file=sys.stderr)
    sys.exit(code)


def opt(name):
    return argv[argv.index(name) + 1] if name in argv else None


def term(addr):
    t = world["terminals"].get(addr)
    if t is None:
        fail(f'no terminal "{addr}"', "not_found", 3)
    return t


fail_prefix = os.environ.get("FAKE_HC_FAIL", "").split()
if fail_prefix and argv[: len(fail_prefix)] == fail_prefix:
    fail("injected failure")

cmd = argv[:2]
if cmd == ["machine", "ls"]:
    out({"machines": world["machines"]})
elif argv[:1] == ["exec"]:
    if "echo $HOME" in argv:
        save()
        print(world["home"])
        sys.exit(0)
    fail(f"fake hc exec does not know {argv}")
elif cmd == ["file", "write"]:
    world["files"][argv[-1]] = sys.stdin.read()
    out({"wrote": argv[-1]})
elif cmd == ["file", "read"]:
    if argv[-1] not in world["files"]:
        fail(f"no file {argv[-1]}", "not_found", 3)
    save()
    print(world["files"][argv[-1]], end="")
    sys.exit(0)
elif argv[:1] == ["run"]:
    on, name, cwd = opt("--on"), opt("--name"), opt("--cwd")
    if on not in {m["name"] for m in world["machines"]}:
        fail(f"no machine {on}", "not_found", 3)
    if any(t["name"] == name and t["state"] == "live" for t in world["terminals"].values()):
        fail(f"a live terminal is already named {name}", "name_taken")
    world["n"] += 1
    addr = f"{on}/t{world['n']}"
    program = argv[argv.index("--") + 1:] if "--" in argv else []
    status = None if (world.get("trust") or world.get("never_ready")) else {"state": "working", "app": "claude-code"}
    world["terminals"][addr] = {"address": addr, "name": name, "cwd": cwd, "state": "live", "status": status,
                                "argv": program, "exit_code": None}
    if world.get("trust"):
        world["screens"][addr] = "Quick safety check\n❯ No, exit\n  Yes, I trust this folder\n"
    out({"address": addr, "name": name, "state": "live", "turn": 0})
elif argv[:1] == ["get"]:
    out(term(argv[1]))
elif argv[:1] == ["read"]:
    term(argv[1])
    save()
    print(world["screens"].get(argv[1], ""))
    sys.exit(0)
elif argv[:1] == ["keys"]:
    t = term(argv[1])
    if world.get("trust") and argv[2:] == ["down", "enter"]:
        t["status"] = {"state": "working", "app": "claude-code"}
        world["screens"][argv[1]] = "❯ working on it\n"
    out({"sent": argv[2:]})
elif argv[:1] == ["wait"]:
    t = term(argv[1])
    reply = world.get("wait") or {"reason": "status", "status": (t["status"] or {}).get("state"), "ended": True,
                                  "terminal": argv[1]}
    if reply.get("then_status"):  # the terminal's status after the wait
        t["status"] = {"state": reply["then_status"], "app": "claude-code"}
    out(reply)
elif argv[:1] == ["kill"]:
    t = term(argv[1])
    t["state"] = "finished"
    t["status"] = None
    out(t)
elif argv[:1] == ["rm"]:
    term(argv[1])
    del world["terminals"][argv[1]]
    out({"removed": argv[1]})
elif argv[:1] == ["ls"]:
    out({"terminals": [t for t in world["terminals"].values() if t["state"] == "live"]})
else:
    fail(f"fake hc does not know {argv}")
